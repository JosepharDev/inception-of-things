Vagrant.configure("2") do |config|
    config.vm.box = "debian/bookworm64"
    config.vm.define "yoyahyaS" do |server|
        server.vm.hostname = "yoyahyaS"
        server.vm.network "private_network", ip: "192.168.56.110"
        server.vm.provider "virtualbox" do |v|
            v.memory = 1024
            v.cpus = 1
        end
    server.vm.provision "shell", path: "scripts/server_script.sh"
    end
    config.vm.define "yoyahyaSW" do |worker|
        worker.vm.hostname = "yoyahyaSW"
        worker.vm.network "private_network", ip: "192.168.56.111"
        worker.vm.provider "virtualbox" do |v|
            v.memory = 1024
            v.cpus = 1
        end
    worker.vm.provision "shell", path: "scripts/worker_script.sh", args: ["192.168.56.110"]
    end
end